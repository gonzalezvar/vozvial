# Copia este archivo como .env y llena solo lo que vayas a usar. .env no se sube a git ni a Railway.
# Ninguna variable es obligatoria: sin ellas el asistente usa el modo verificado y la base es PGlite en memoria.

# Asistente con Claude (servidor). Sin ella, modo verificado.
ANTHROPIC_API_KEY=

# Base de datos. Sin DATABASE_URL se usa PGlite; con PGLITE_DIR los datos quedan en esa carpeta.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/vozvial
# PGLITE_DIR=.datos-locales

# Secreto del servidor para la sal falsa de celulares no registrados (32 caracteres o más).
# Genera uno con: openssl rand -hex 32
# SECRETO_SERVIDOR=
